{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["src/**/*.test.ts"],
	"ignoreDependencies": ["@ingram-tech/nk-dev"],
	"rules": {
		"exports": "off",
		"types": "off",
		"nsExports": "off",
		"nsTypes": "off",
		"enumMembers": "off",
		"duplicates": "off"
	},
	"ignore": ["vendor/**"]
}
